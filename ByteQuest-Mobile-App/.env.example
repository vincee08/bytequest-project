# Mobile-safe Supabase client configuration.
# Use only the publishable/anonymous key here; never put a service-role key in the app.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=

# Public authenticated practice endpoint; AI credentials remain on the server.
# Alternatively use --dart-define=BQ_PRACTICE_API_URL=https://your-dashboard/api/learner/practice
PRACTICE_API_URL=
